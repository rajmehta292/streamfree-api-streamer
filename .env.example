# Server Configuration
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Upstream StreamFree Configuration
STREAMFREE_PRIMARY_MIRROR=https://strmfree.st
STREAMFREE_FALLBACK_MIRRORS=https://streamfree.top,https://strmfree.link,https://strmfree.pk

# Caching Configuration (in milliseconds)
CACHE_TTL_STREAMS_MS=30000
CACHE_TTL_SOURCES_MS=15000
CACHE_TTL_CATEGORIES_MS=3600000

# Background Sync & Real-time SSE updates (in milliseconds)
AUTO_REFRESH_INTERVAL_MS=30000

# Feature Flags
ENABLE_CUSTOM_STREAMS=true
ALLOW_DIRECT_HLS_PROXY=true

