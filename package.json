{
  "name": "streamfree-api-streamer",
  "version": "1.0.0",
  "description": "High-performance custom streaming application and API streamer implementing the full StreamFree API specification with mirror failover, multi-view, and ad-free custom players.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"import('node:fs').then(fs => fs.cpSync('src/public', 'dist/public', {recursive: true}))\"",
    "start": "node dist/server.js",
    "start:tsx": "tsx src/server.ts",
    "test": "tsx test/api.test.ts"
  },
  "keywords": [
    "streamfree",
    "streaming-api",
    "sports-streams",
    "fastify",
    "hls",
    "multiview",
    "video-streamer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "lru-cache": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
